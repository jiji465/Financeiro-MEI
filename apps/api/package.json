{
  "name": "@meifin/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do MEI Financeiro (Fastify 5 + Drizzle + PGlite/Postgres)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts --demo",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/db/backup.ts",
    "db:promote-admin": "tsx --env-file-if-exists=../../.env src/db/seed/promote-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@meifin/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "papaparse": "5.7.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
