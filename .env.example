# ---------------------------------------------------------------------------
# MEI Financeiro — variáveis de ambiente
# Copie este arquivo para ".env" na raiz do repositório e ajuste os valores.
# ---------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Servidor da API
PORT=3333
HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# URL pública do frontend (usada em links de e-mail, redirecionamentos etc.)
APP_URL=http://127.0.0.1:5173
# Origens permitidas no CORS, separadas por vírgula (padrão: APP_URL)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Banco de dados
# Vazio → usa PGlite local (Postgres embarcado, sem instalação).
# Em produção cole aqui a URL do Supabase/Neon (postgresql://usuario:senha@host:5432/banco?sslmode=require)
DATABASE_URL=
# Pasta dos dados do PGlite. Padrão: %LOCALAPPDATA%\meifin\pglite (fora do OneDrive). Testes usam memory://
PGLITE_DATA_DIR=

# Autenticação (mínimo 32 caracteres; em produção o prefixo "dev-" é rejeitado)
JWT_ACCESS_SECRET=dev-access-secret-troque-em-producao-0000000000
JWT_REFRESH_SECRET=dev-refresh-secret-troque-em-producao-000000000
# Tempo de vida do access token (formato do @fastify/jwt, ex.: 15m, 1h)
JWT_ACCESS_TTL=15m
# Tempo de vida do refresh token, em dias
JWT_REFRESH_TTL_DAYS=30
# Validade do link de redefinição de senha, em minutos
PASSWORD_RESET_TTL_MINUTES=60

# Servir o frontend compilado (apps/web/dist) pela própria API (deploy single-service)
SERVE_WEB=false
# Pasta do build do frontend (padrão: apps/web/dist)
WEB_DIST_DIR=

# Documentação OpenAPI em /docs (padrão: true fora de produção)
SWAGGER=true

# Fuso horário de negócio (cálculo de "hoje", vencimentos etc.)
TZ_BUSINESS=America/Sao_Paulo

# Armazenamento de anexos (lançamentos e notas fiscais): local | s3
# "local" grava em disco — ótimo em dev, mas some a cada deploy em serviços com disco efêmero
# (ex.: plano gratuito do Render). Em produção use "s3" com um bucket do Supabase Storage
# (compatível com S3) ou qualquer outro provedor S3.
STORAGE_DRIVER=local
# Endpoint S3 (Supabase: https://<projeto>.supabase.co/storage/v1/s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
